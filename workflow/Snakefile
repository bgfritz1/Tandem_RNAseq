rule all:
	input:
		input_files,
		#expand(OUT + "/unmapped/{sample}_unmapped.featureCounts", sample = getSampleNames("PAIRED")),
		#OUT + "/unmapped/count_matrix_unmapped.tsv"


#=====================================
# Concatenate across sequencing lanes
#=====================================

rule concat_lanes_pe:
	input:
		r1=lambda wc: getFastqsToConcat(wc.sample)[0],
		r2=lambda wc: getFastqsToConcat(wc.sample)[1],
	output:
		r1=temp(OUT + "/concat/{sample}.concat.R1.fastq.gz"),
		r2=temp(OUT + "/concat/{sample}.concat.R2.fastq.gz"),
	log:
		OUT + "/logs/concat/{sample}.log",
	shell:
		"(cat {input.r1} > {output.r1} && cat {input.r2} > {output.r2}) 2> {log}"

rule concat_lanes_se:
	input:
		r1=lambda wc: getFastqsToConcat(wc.sample)[0],
	output:
		r1_concat=OUT + "/concat/{sample}.concat.fastq.gz",
	log:
		OUT + "/logs/concat/{sample}.log",
	shell:
		"cat {input.r1} > {output.r1_concat} 2> {log}"

#============================================
# Trim Adapter Sequences and Size Selection
#============================================

# cutadapt_se's "{sample}.qc.txt" also matches the PE "{sample}.concat.qc.txt"
ruleorder: cutadapt_pe > cutadapt_se

rule cutadapt_pe:
	input:
		r1 = OUT + "/concat/{sample}.concat.R1.fastq.gz",
		r2 = OUT + "/concat/{sample}.concat.R2.fastq.gz"
	output:
		fastq1=OUT + "/trimmed/{sample}.trim.R1.fastq.gz",
		fastq2=OUT + "/trimmed/{sample}.trim.R2.fastq.gz",
		qc=OUT + "/trimmed/{sample}.concat.qc.txt",
	params:
		extra="{}".format(config["params"]["cutadapt-pe"]),
	resources:
		walltime="4:00:00",
		nodes="1",
		ppn="12",
		size="thinnode",
		mem="40gb",
	log:
		OUT + "/logs/cutadapt/{sample}.trim.log",
	threads: 12
	wrapper:
		"v2.6.0/bio/cutadapt/pe"

rule cutadapt_se:
	input:
		OUT + "/concat/{sample}.concat.fastq.gz"
	output:	
		fastq=OUT + "/trimmed/{sample}.trim.fastq.gz",
		qc=OUT + "/trimmed/{sample}.qc.txt"
	params:
		extra="{}".format(config["params"]["cutadapt-se"]),
	resources:
		walltime="4:00:00",
		nodes="1",
		ppn="12",
		size="thinnode",
		mem="40gb",
	log:
		OUT + "/logs/cutadapt/{sample}.log"
	threads: 12 # set desired number of threads here
	wrapper:
		"v2.6.0/bio/cutadapt/se"

#=============================================
# Alignment with STAR 
#=============================================

# Make sure STAR index gtf is not gzipped

if REF_GTF_RAW.endswith(".gz"):
	rule gunzip_gtf:
		input:
			REF_GTF_RAW
		output:
			temp(REF_GTF)
		shell:
			"gunzip -c {input} > {output}"

if REF_FA_RAW.endswith(".gz"):
	rule gunzip_fasta:
		input:
			REF_FA_RAW
		output:
			temp(REF_FA)
		shell:
			"gunzip -c {input} > {output}"

rule star_index:
	input:
		fasta=REF_FA,
		gtf=REF_GTF,
	output:
		directory(config["aligner"]["reference_dir"] + config["aligner"]["db_prefix"]),
	message:
		"Make STAR index"
	threads: 12
	params:
		sjdbOverhang=config["params"]["kraken"]["read_length"] - 1,
		extra=config["aligner"].get("star_index_extra", ""),
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="80gb",
	log:
		f"{OUT}/logs/star_index_{config['aligner']['db_prefix']}.log",
	wrapper:
		"v9.19.2/bio/star/index"

rule star_pe_multi:
    input:
        fq1=[OUT + "/trimmed/{sample}.trim.R1.fastq.gz"],
        fq2=[OUT + "/trimmed/{sample}.trim.R2.fastq.gz"],  
        # path to STAR reference genome index
        idx=config["aligner"]["reference_dir"] + config["aligner"]["db_prefix"]
    output:
        # see STAR manual for additional output files
        aln=OUT + "/star/pe/{sample}/pe_aligned.bam",
        log=OUT + "/logs/pe/{sample}/Log.out",
        log_final=OUT + "/logs/pe/{sample}/Log.final.out",
        sj=OUT + "/star/pe/{sample}/SJ.out.tab",
        unmapped=[OUT + "/star/pe/{sample}/unmapped.1.fastq.gz",OUT + "/star/pe/{sample}/unmapped.2.fastq.gz"],
    log:
        OUT + "/logs/pe/{sample}.log",
    params:
        # optional parameters
        # --limitBAMsortRAM: memory for coordinate sorting (bytes), on top of the loaded genome
        extra="--outSAMtype BAM SortedByCoordinate --outSAMattributes NH HI AS nM NM MD --limitBAMsortRAM 20000000000",
    threads: 12
    resources:
        walltime="12:00:00",
        nodes="1",
        ppn="12",
        mem="64gb"
    wrapper:
        "v9.19.2/bio/star/align"

#=============================================
# Alignment with bwa-mem
#=============================================

rule bwa_index:
	input:
		ref=config["aligner"]["reference_dir"]+config["aligner"]["reference_fq"]
	output:
		idx=multiext(config["aligner"]["reference_dir"]+config["aligner"]["db_prefix"], ".amb", ".ann", ".bwt", ".pac", ".sa"),
	log:
		f"{OUT}/logs/bwa_index_{config['aligner']['db_prefix']}.log"
	params:
		algorithm="bwtsw",
		prefix=config["aligner"]["reference_dir"]+config["aligner"]["db_prefix"],
		block_size="100000000",
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="40gb"
	threads: 12
	conda: 
		"envs/bwa.yaml"
	shell:
		"bwa index " "-b {params.block_size} -p {params.prefix} " "-a {params.algorithm} " " {input}" " 2>{log}"

rule bwa_mem:
	input:
		reads = [OUT + "/trimmed/{sample}.trim.R1.fastq.gz", OUT + "/trimmed/{sample}.trim.R2.fastq.gz"],
		idx = multiext(config["aligner"]["reference_dir"]+config["aligner"]["db_prefix"], ".amb", ".ann", ".bwt", ".pac", ".sa"),
	output:
		OUT + "/bwa_mem/{sample}.bam",
	log:
		OUT + "/logs/bwa_mem/{sample}.log",
	params:
		extra=r"-R '@RG\tID:{sample}\tSM:{sample}'",
		sorting="none",  # Can be 'none', 'samtools' or 'picard'.
		sort_order="queryname",  # Can be 'queryname' or 'coordinate'.
		sort_extra="",  # Extra args for samtools/picard.
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="40gb",
	threads: 12
	wrapper:
		"v9.4.1/bio/bwa/mem"

rule samtools_stats:
	input:
		bam = OUT + "/star/pe/{sample}/pe_aligned.bam"
	output:
		OUT + "/samtools_stats/{sample}.txt",
	params:
		extra="",  # Optional: extra arguments.
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="15gb",
	log:
		OUT + "/logs/samtools_stats/{sample}.log",
	wrapper:
		"v9.4.1/bio/samtools/stats"


rule get_unmapped_pe:
	input: 
		OUT + "/bwa_mem/{sample}.bam"
	output:
		fq1=OUT + "/unmapped/{sample}_unmapped_R1.fq.gz",
		fq2=OUT + "/unmapped/{sample}_unmapped_R2.fq.gz",
		bam=temp(OUT + "/unmapped/{sample}_unmapped.bam")
	conda: 
		"envs/bwa.yaml"
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="30gb",
	threads: 12
	params:
		outdir=OUT,
	log:
		OUT + "/logs/bwa_mem/{sample}_getunmapped.log"
	shell:
		"""
		samtools view -b -f 4 {input} > {output.bam} 
		
		bedtools bamtofastq -i {output.bam} \
			-fq {params.outdir}/unmapped/{wildcards.sample}_unmapped_R1.fq \
			-fq2 {params.outdir}/unmapped/{wildcards.sample}_unmapped_R2.fq 2>{log}
		
		pigz -p {threads} {params.outdir}/unmapped/{wildcards.sample}_unmapped_R1.fq {params.outdir}/unmapped/{wildcards.sample}_unmapped_R2.fq
		"""

rule get_unmapped_se:
	input: 
		OUT + "/bwa_mem/{sample}.bam"
	output:
		fq1=OUT + "/unmapped/{sample}_unmapped.fq.gz",
		bam=temp(OUT + "/unmapped/{sample}_unmapped.bam")
	conda: 
		"envs/bwa.yaml"
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="30gb",
	threads: 12
	params:
		outdir=OUT,
	log:
		OUT + "/logs/bwa_mem/{sample}_getunmapped.log"
	shell:
		"""
		samtools view -b -f 4 {input} > {output.bam} 
		
		bedtools bamtofastq -i {output.bam} \
			-fq {params.outdir}/unmapped/{wildcards.sample}_unmapped.fq 2>{log}
		
		pigz -p {threads} {params.outdir}/unmapped/{wildcards.sample}_unmapped.fq
		"""

