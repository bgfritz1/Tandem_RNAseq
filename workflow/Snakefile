#=======================================================
# Classify Reads with Kraken2
#=======================================================

ruleorder: kraken2_classify_PE > kraken2_classify_SE #Assume PE first, then try SE

rule kraken_build:
	input: 
		pathname = config["refs"]["kraken_db_dir"]

	output:
		hash = "{config['refs']['kraken_db_dir']}/hash.t2d",
		taxo = "{config['refs']['kraken_db_dir']}/taxo.t2d", 
		opts = "{config['refs']['kraken_db_dir']}/opts.t2d"
	log:
		OUT + "/logs/kraken/kraken_build.log"
	threads: 12
	conda:
		"envs/kraken.yaml"
	shell:
		"""
		mkdir -p {params.kraken_db}
		k2-build --standard --db {input.pathname} 1>{log} 2>&1 || true
		"""

# Classify reads that STAR could not align to the host genome (host depletion)
rule kraken2_classify_PE:
	input:
		fq1=OUT + "/star/pe/{sample}/unmapped.1.fastq.gz",
		fq2=OUT + "/star/pe/{sample}/unmapped.2.fastq.gz",
		db=config["refs"]["kraken_db_dir"],
	output:
		OUT + "/kraken/{sample}.kraken.out"
	log:
		OUT + "/logs/kraken/{sample}.log"
	params:
		confidence=config["params"]["kraken"].get("confidence", 0.1),
	threads: 20
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="20",
		mem="90gb",
	conda:
		"envs/kraken.yaml"
	shell:
		"kraken2 --threads {threads} --db {input.db} --confidence {params.confidence} --report-zero-counts --paired --output - --report {output} {input.fq1} {input.fq2} 2>{log}"

rule kraken2_classify_SE:
	input:
		fq=OUT + "/rRNA_dep/{sample}_rRNAdep.fq.gz",
		db=config["refs"]["kraken_db_dir"],

	output:
		OUT + "/kraken/{sample}.kraken.out"
	log:
		OUT + "/logs/kraken/{sample}.log"
	threads: 20
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="20",
		mem="80gb",
	conda:
		"envs/kraken.yaml"
	shell:
		"kraken2 --threads {threads} --db {input.db} --report-zero-counts --output - --report {output} {input.fq} 2>{log}"
	

#=======================================================
# Estimate bacterial abundance with Bracken
#=======================================================

rule bracken_build:
	input:
		# depends on kraken DB having been built
		kraken_db_built = directory(config["refs"]["kraken_db_dir"])
	output:
		OUT + "/bracken/bracken_db"
	params:
		read_length=lambda wildcards: config["params"]["kraken"]["read_length"],
		kmer=lambda wildcards: config["params"]["kraken"].get("kmer", 35),
		kraken_db=lambda wildcards: config["refs"]["kraken_db_dir"] if isinstance(config["refs"]["kraken_db_dir"], str) else config["refs"]["kraken_db_dir"][0]
	log:
		OUT + "/logs/bracken/bracken_build.log"
	threads: 4
	conda:
		"envs/kraken.yaml"
	shell:
		"""
		bracken-build -d {params.kraken_db} -t {threads} -k {params.kmer} -l {params.read_length} 1>{log} 2>&1 || true
		"""

rule braken_estimate:
	input:
		kraken_out=OUT + "/kraken/{sample}.kraken.out",
	output:
		OUT + "/bracken/{sample}.bracken.out"
	log:
		OUT + "/logs/bracken/{sample}_bracken.log"
	threads: 12
	params:
		kraken_db=config["refs"]["kraken_db_dir"],
		read_length=config["params"]["kraken"]["read_length"],
		threshold=0, 
		classification_lvl="S",
		outdir=OUT,
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="15gb",
	conda:
		"envs/kraken.yaml"
	shell:
		"bracken -d {params.kraken_db} -i {input.kraken_out} -o {output} -w {params.outdir}/bracken/{wildcards.sample}_bracken_species.out -r {params.read_length} -t {params.threshold} -l {params.classification_lvl} 1>{log}"


rule abundance_table:
	input: 
		kraken=expand(OUT + "/kraken/{sample}.kraken.out", sample = getSampleNames("ALL")),
		bracken=expand(OUT + "/bracken/{sample}.bracken.out", sample = getSampleNames("ALL")),
	output:
		[OUT + "/bracken/bac_abundance_table.csv", OUT + "/bracken/bac_count_table.csv"]
	log:
		OUT + "/logs/bracken/bac_abundance_table.log"
	threads: 1
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="8",
		mem="12gb",
	conda:
		"envs/R.yaml"
	script:
		"scripts/abundance_table.R"

#==============================
# Quality Control with Multiqc 
#==============================

rule test_multiqc_file:
  input:
    expand(OUT + "/trimmed/{sample}.concat.qc.txt", sample = getSampleNames("ALL")),
    expand(OUT + "/logs/pe/{sample}/Log.final.out", sample = getSampleNames("ALL")),
    expand(OUT + "/samtools_stats/{sample}.txt", sample = getSampleNames("ALL")),
    expand(OUT + "/counts/{sample}.featureCounts.summary", sample = getSampleNames("ALL")),
    expand(OUT + "/kraken/{sample}.kraken.out", sample = getSampleNames("ALL")) if config["run_kraken"] else [],
    config=os.path.join(workflow.basedir, "multiqc_config.yaml"),
  output:
      OUT + "/qc/multiqc.html",
      OUT + "/qc/multiqc_data.zip",
  params:
      extra="--verbose",  # Optional: extra parameters for multiqc.
      use_input_files_only=True,  # only parse the listed files, not everything in their folders
  log:
      OUT + "/logs/multiqc.log",
  wrapper:
      "v9.4.1/bio/multiqc"

rule qc_summary:
