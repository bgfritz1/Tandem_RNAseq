import pandas as pd 
import os
from snakemake.utils import min_version
import pdb

min_version("9.0.0")

# Default config; override with --configfile (e.g. tests/config/config.yaml)
configfile: "config/config.yaml"

#=============================
# Output directory
#=============================
# All pipeline outputs are written under this directory - defined in config 

OUT = str(config.get("outdir", "results")).rstrip("/")

# Exported so the cluster submit script (config/Computerome2/pbs-submit.py)
# can place PBS .o/.e files under the same output directory.
os.environ["TANDEM_OUTDIR"] = OUT

#=============================
# Get the sample information
#=============================

sample_information = pd.read_csv(config['samples'], sep='\t', comment='#',index_col=False)
sample_units = pd.read_csv(config["units"], sep="\t", comment="#",index_col=False)

#Still maybe a better way to do this, but better than before
sample_names = list(sample_information['sample'])

#=============================
# Make sure GTF is not gzipped 
#=============================

def unzipped(path):
	return path[:-3] if path.endswith(".gz") else path

REF_FA_RAW  = config["aligner"]["reference_dir"] + config["aligner"]["reference_fq"]
REF_GTF_RAW = config["aligner"]["reference_dir"] + config["aligner"]["annotation_gtf"]
REF_FA  = unzipped(REF_FA_RAW)
REF_GTF = unzipped(REF_GTF_RAW)

#=============================
# Define Functions
#=============================

def getRawFastqs(sample, unit):
	u = sample_fq_dict[(sample,unit)]
	return([u[0], u[1]])

def getFastqsToConcat(sample):
	u = sample_units[sample_units["sample"] == sample].sort_values("unit")
	return [u["fq1"].tolist(), u["fq2"].dropna().tolist()]

def getSampleNames(strategy):
	if (strategy in ["PAIRED", "SINGLE"]):
		samples = sample_information.loc[sample_information['strategy'] == strategy, 'sample']
	if (strategy=="ALL"):
		samples = sample_information['sample']
	return(samples)

def getSeqStrategy(sample):
	return(sample_information.loc[sample_information['sample'] == sample, 'strategy'])

def getLibStrandedness(sample):
	strandedness = sample_information.loc[sample_information['sample'] == sample, 'strandedness']
	return(strandedness.item())

def get_rNAseq_database_arg():
	databases = config["refs"]["rRNA_ref_dbs"]
	arg = ""
	for database in databases:
		arg = f"{arg} --ref resources/rRNA_ref/{database}.fastq"
	return(arg)

def get_rRNA_dep(wildcards):
	pairedness = getSeqStrategy(wildcards['sample'])
	if (pairedness.item() == "PAIRED"): 
		return(expand(
			OUT + "/rRNA_dep/{sample}_rRNAdep_{read}.fq.gz",
			read=['fwd', 'rev'],
			**wildcards,
		))
	if (pairedness.item() == "SINGLE"):
		return(expand(
			OUT + "/rRNA_dep/{sample}_rRNAdep.fq.gz",
			**wildcards,
		))

def get_unmapped(wildcards):
	pairedness = getSeqStrategy(wildcards['sample'])
	if (pairedness.item() == "PAIRED"): 
		return(expand(
			OUT + "/unmapped/{sample}_unmapped_{read}.fq.gz",
			read=['R1', 'R2'],
			**wildcards,
		))
	if (pairedness.item() == "SINGLE"):
		return(expand(
			OUT + "/rRNA_dep/{sample}_unmapped.fq.gz",
			**wildcards,
		))


alignment_files = expand(OUT + "/counts/{sample}{ending}", sample = getSampleNames("ALL"), ending = [".featureCounts", ".featureCounts.summary",".featureCounts.jcounts"]),
count_matrix = OUT + "/counts/count_matrix.tsv",

# Disabiling kraken abundance estimations for not. Need to find a good alternative for a small testing data set for kraken
# Probably will work fine when directed to full kraken db...But not tested!

kraken_files = expand(OUT + "/kraken/{sample}.kraken.out", sample = getSampleNames("ALL"))
bracken_files = [OUT + "/bracken/bac_abundance_table.csv",OUT + "/bracken/bac_count_table.csv"],

unaligned_files = expand(OUT + "/unmapped/{sample}_unmapped_{read}.fq.gz", sample = getSampleNames("ALL"), read = ["R1", "R2"])
muliqc_out = OUT + "/qc/multiqc.html"
qc = OUT + "/qc/qc_summary.txt"

input_files = []

if config['run_alignment']:
	input_files.append(alignment_files)
	input_files.append(count_matrix)

if config['run_kraken']:
	input_files.append(kraken_files)

if config['run_bracken']:
	input_files.append(bracken_files)

if config["unmapped_reads"]["keep_unmapped"]:
	input_files.append(unaligned_files)

if config["run_multiqc"]:
	input_files.append(muliqc_out)
	#input_files.append(qc)

