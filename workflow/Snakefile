		samtools = OUT + "/qc/multiqc_data/multiqc_samtools_stats.txt",
	output:
		OUT + "/qc/qc_summary.txt"
	params:
		extra=""
	resources:
		walltime="12:00:00",
		nodes="1",
		ppn="12",
		mem="15gb"
	log: 
		OUT + "/logs/qc_summary/log.txt"
	conda:
		"envs/R.yaml"
	script:
		"scripts/summary_stats.R"

